# Optional: enables deeper AI vision analysis for artwork-matched website generation.
# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini

# Required for durable public publishing and private admin authentication.
# Keep this server-side, then run `npm run db:migrate` so every migration —
# including 004_admin_auth.sql — is applied before enabling /admin.
DATABASE_URL=

# Required only to run `npm run deploy:factory:robinhood` (see README.md
# "Factory deployment"). Never commit real values. HOODLUMS_FACTORY_DEPLOYER_PRIVATE_KEY
# must be a funded testnet-only key and is never read by the app itself.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
HOODLUMS_FACTORY_DEPLOYER_PRIVATE_KEY=
HOODLUMS_FACTORY_OWNER_ADDRESS=
HOODLUMS_FACTORY_TREASURY_ADDRESS=

# Optional: public JSON map of chainId -> deployed HoodlumsTokenFactory
# address, populated once a deployment above is verified. Safe to expose to
# the browser; contains no secrets.
NEXT_PUBLIC_HOODLUMS_FACTORY_ADDRESSES=

# Required only to run `npm run deploy:bonding-curve:robinhood` (see
# README.md "Bonding curve deployment (drill)"). Never commit real values.
# HOODLUMS_BONDING_CURVE_DEPLOYER_PRIVATE_KEY must be a funded testnet-only
# key and is never read by the app itself.
HOODLUMS_BONDING_CURVE_DEPLOYER_PRIVATE_KEY=
HOODLUMS_BONDING_CURVE_TOKEN_ADDRESS=
HOODLUMS_BONDING_CURVE_CREATOR_ADDRESS=
HOODLUMS_BONDING_CURVE_TREASURY_ADDRESS=
# Required: the curve graduates into a full-range Uniswap V3 position via
# these three addresses (constructor immutables, no hardcoded fallback in
# code — see README.md "Bonding curve deployment (drill)" and issue #227).
# Get the canonical addresses for your target chain directly from Uniswap's
# own official docs (developers.uniswap.org) before deploying — do not
# reuse addresses pasted into a chat or issue without independently
# re-verifying them there. The values below are the known Robinhood Chain
# mainnet (4663) deployments as verified from Uniswap's docs at the time of
# issue #227; they are examples only, not defaults — the contract and this
# script never fall back to them if these env vars are unset.
# HOODLUMS_BONDING_CURVE_POSITION_MANAGER_ADDRESS=0x73991a25c818bf1f1128deaab1492d45638de0d3
# HOODLUMS_BONDING_CURVE_UNISWAP_V3_FACTORY_ADDRESS=0x1f7d7550b1b028f7571e69a784071f0205fd2efa
# HOODLUMS_BONDING_CURVE_WETH9_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
HOODLUMS_BONDING_CURVE_POSITION_MANAGER_ADDRESS=
HOODLUMS_BONDING_CURVE_UNISWAP_V3_FACTORY_ADDRESS=
HOODLUMS_BONDING_CURVE_WETH9_ADDRESS=
# Reference only — NOT read by this script or the contract (the curve only
# needs the three addresses above to seed liquidity). Listed here purely so
# the other known Robinhood Chain mainnet (4663) Uniswap V3 deployments are
# in one place for any future trading-UI work (swaps/quotes), same sourcing
# caveat as above. SwapRouter02=0xcaf681a66d020601342297493863e78c959e5cb2
# QuoterV2=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
# UniversalRouter=0x8876789976decbfcbbbe364623c63652db8c0904
# Permit2=0x000000000022D473030F116dDEE9F6B43aC78BA3 (this is Permit2's
# well-known canonical cross-chain deployment address; the value pasted into
# issue #227 was one hex digit short of a valid address, so re-verify this
# independently before relying on it for anything beyond documentation).
# Optional overrides — see README.md for defaults (decimals 18, graduation
# target 4 native tokens, virtual reserves 1,000,000 token / 1 native).
HOODLUMS_BONDING_CURVE_TOKEN_DECIMALS=
HOODLUMS_BONDING_CURVE_GRADUATION_TARGET_ETHER=
HOODLUMS_BONDING_CURVE_VIRTUAL_ETH_RESERVE_ETHER=
HOODLUMS_BONDING_CURVE_VIRTUAL_TOKEN_RESERVE_WHOLE=

# Required only to run `npm run graduate:bonding-curve:robinhood` (see
# README.md "Bonding curve deployment (drill)"). Never commit real values.
# HOODLUMS_BONDING_CURVE_CREATOR_PRIVATE_KEY must belong to the wallet that
# holds the token's complete current supply (the curve's `creator`).
HOODLUMS_BONDING_CURVE_CREATOR_PRIVATE_KEY=
HOODLUMS_BONDING_CURVE_ADDRESS=
# Optional: size of each intermediate buy while driving toward graduation.
HOODLUMS_BONDING_CURVE_BUY_STEP_ETHER=

# Optional: public JSON map of chainId -> deployed HoodlumsTestBondingCurve
# address (see README.md "Bonding curve deployment (drill)"). Safe to expose
# to the browser; contains no secrets. Read by the public token page
# (app/token/[chain]/[address]/page.tsx) to decide whether to show live
# buy/sell controls for a given token, or fall back to the "Trade on
# terminal" referral links below.
NEXT_PUBLIC_HOODLUMS_BONDING_CURVE_ADDRESSES=

# Optional: referral codes baked into the public token page's "Trade on"
# links (app/token/[chain]/[address]/page.tsx via lib/trade-terminal-links.ts).
# Public config only — never secrets, safe to expose to the browser. Each
# unset code degrades that platform's link to a plain, un-refcoded URL.
NEXT_PUBLIC_GMGN_REF_CODE=
NEXT_PUBLIC_AXIOM_REF_CODE=
NEXT_PUBLIC_MAESTRO_REF_CODE=
NEXT_PUBLIC_AVE_REF_CODE=

# Optional: set to "true" locally to show the testnet-only Liquidity Lab and
# Bonding Curve tabs (plus the "Testnet mode" sidebar note) in the nav.
# Leave unset/false in production so public visitors only see the 3-step
# Create & Bond / Providers / Allocations workflow. Safe to expose to the
# browser; contains no secrets.
NEXT_PUBLIC_SHOW_TESTNET_TOOLS=

# Required to use the private /admin dashboard (see README.md "Admin
# dashboard"). Keep both server-side and never commit real values. Admin
# challenges and sessions are stored as hashes in Postgres via DATABASE_URL.
# ADMIN_WALLET_ADDRESS is the single EVM address allowed to sign in with a
# wallet signature; leaving it unset disables wallet admin login.
ADMIN_WALLET_ADDRESS=
# ADMIN_PASSWORD is the fallback secret for signing in without that wallet
# (e.g. from a phone away from the desktop wallet). Leaving it unset disables
# password admin login. Compared in constant time and never logged.
ADMIN_PASSWORD=
# Optional: overrides the same-origin check for /api/admin/* requests. Falls
# back to PUBLISH_ALLOWED_ORIGIN, then GENERATE_SITE_STYLE_ALLOWED_ORIGIN,
# then the request's own origin. Only needed if those don't already match
# the origin the admin dashboard is served from.
ADMIN_ALLOWED_ORIGIN=

# Required for live plan payments and subscription renewals on Robinhood
# Chain mainnet. Keep every value server-side. Chain 4663 is mainnet; 46630
# is testnet and must not be used for live subscriptions.
HOODLUMS_TREASURY_ADDRESS=
HOODLUMS_PAYMENT_RPC_URL=https://rpc.mainnet.chain.robinhood.com
HOODLUMS_PAYMENT_CHAIN_ID=4663
HOODLUMS_PAYMENT_CHAIN_NAME=Robinhood Chain
HOODLUMS_PAYMENT_EXPLORER_URL=https://robinhoodchain.blockscout.com
# JSON list of payment tokens. Only enabled entries appear at checkout.
# USDG address is the Paxos-published Robinhood mainnet contract. USDT is
# deliberately disabled because no canonical, materially liquid contract was
# verified on the official explorer during implementation review.
HOODLUMS_PAYMENT_TOKENS_JSON=[{"symbol":"USDG","contractAddress":"0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168","decimals":6,"enabled":true,"note":"Paxos-issued Global Dollar on Robinhood Chain mainnet"},{"symbol":"USDT","contractAddress":null,"decimals":null,"enabled":false,"note":"Disabled: no canonical liquid USDT contract verified on Robinhood Chain"}]
# Bond + Pro Site remains a one-off native ETH payment priced in exact wei.
HOODLUMS_BOND_PRO_SITE_AMOUNT_WEI=

# Daily subscription lifecycle job and optional Telegram renewal reminders.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
HOODLUMS_APP_ORIGIN=https://hoodlums.dev
