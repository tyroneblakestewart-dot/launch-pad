{
  "name": "private-meme-token-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npx vitest run tests/[g-h]*.test.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run && hardhat test solidity",
    "test:app": "vitest run",
    "test:contracts": "hardhat test solidity",
    "test:watch": "vitest",
    "contracts:compile": "hardhat compile",
    "deploy:factory:robinhood": "hardhat run scripts/deploy-hoodlums-factory.ts --network robinhoodTestnet",
    "deploy:bonding-curve:robinhood": "hardhat run scripts/deploy-hoodlums-bonding-curve.ts --network robinhoodTestnetBondingCurveDeploy",
    "graduate:bonding-curve:robinhood": "hardhat run scripts/graduate-hoodlums-bonding-curve.ts --network robinhoodTestnetBondingCurveCreator",
    "db:migrate": "node scripts/migrate-database.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.55.2"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "hardhat": "3.11.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
