{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "AI_GATEWAY_MODEL": "openai/gpt-5-nano"
  },
  "functions": {
    "app/api/generate-site-page/route.ts": {
      "maxDuration": 180
    },
    "app/api/cron/subscription-lifecycle/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/outreach/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/social-posting/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/buy-bot/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/subscription-lifecycle",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/outreach",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/social-posting",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/buy-bot",
      "schedule": "* * * * *"
    }
  ]
}
